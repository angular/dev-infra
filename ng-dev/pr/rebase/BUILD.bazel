load("//tools:defaults.bzl", "jasmine_test", "ts_project")

ts_project(
    name = "rebase",
    srcs = [
        "cli.ts",
        "index.ts",
    ],
    visibility = [
        "//github-actions/slash-commands:__subpackages__",
        "//ng-dev:__subpackages__",
    ],
    deps = [
        "//ng-dev:node_modules/@types/node",
        "//ng-dev:node_modules/@types/yargs",
        "//ng-dev:node_modules/conventional-commits-parser",
        "//ng-dev:node_modules/typed-graphqlify",
        "//ng-dev:node_modules/yargs",
        "//ng-dev/commit-message",
        "//ng-dev/pr/common",
        "//ng-dev/utils",
    ],
)

ts_project(
    name = "test_lib",
    testonly = True,
    srcs = glob(["*.spec.ts"]),
    deps = [
        ":rebase",
        "//ng-dev:node_modules/@types/jasmine",
        "//ng-dev:node_modules/@types/node",
        "//ng-dev:node_modules/nock",
        "//ng-dev/utils",
        "//ng-dev/utils/testing",
    ],
)

jasmine_test(
    name = "test",
    data = [
        ":test_lib",
    ],
    env = {
        "GIT_BIN": "$(GIT_BIN_PATH)",
    },
    toolchains = ["@devinfra//bazel/git-toolchain:current_git_toolchain"],
)
