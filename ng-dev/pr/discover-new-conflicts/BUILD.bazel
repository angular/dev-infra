load("//tools:defaults.bzl", "jasmine_test", "ts_project")

ts_project(
    name = "discover-new-conflicts",
    srcs = [
        "cli.ts",
        "index.ts",
    ],
    visibility = ["//ng-dev:__subpackages__"],
    deps = [
        "//ng-dev:node_modules/@types/cli-progress",
        "//ng-dev:node_modules/@types/node",
        "//ng-dev:node_modules/@types/yargs",
        "//ng-dev:node_modules/cli-progress",
        "//ng-dev/pr/common",
        "//ng-dev/utils",
    ],
)

ts_project(
    name = "test_lib",
    testonly = True,
    srcs = glob(["*.spec.ts"]),
    deps = [
        ":discover-new-conflicts",
        "//ng-dev:node_modules/@types/jasmine",
        "//ng-dev:node_modules/@types/node",
        "//ng-dev:node_modules/nock",
        "//ng-dev/utils",
        "//ng-dev/utils/testing",
    ],
)

jasmine_test(
    name = "test",
    data = [
        ":test_lib",
    ],
    env = {
        "GIT_BIN": "$(GIT_BIN_PATH)",
    },
    toolchains = ["@devinfra//bazel/git-toolchain:current_git_toolchain"],
)
