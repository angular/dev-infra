load("//tools:defaults.bzl", "copy_to_bin", "jasmine_test", "ts_project")

copy_to_bin(
    name = "commit-message-filter",
    srcs = [
        "commit-message-filter.ts",
    ],
    visibility = [
        "//ng-dev:__pkg__",
    ],
)

ts_project(
    name = "checkout",
    srcs = glob(
        ["*.ts"],
        exclude = ["*.spec.ts"],
    ),
    visibility = ["//ng-dev:__subpackages__"],
    deps = [
        "//ng-dev:node_modules/@types/node",
        "//ng-dev:node_modules/@types/yargs",
        "//ng-dev/pr/common",
        "//ng-dev/release/versioning",
        "//ng-dev/utils",
    ],
)

ts_project(
    name = "test_lib",
    testonly = True,
    srcs = glob(["*.spec.ts"]),
    deps = [
        ":checkout",
        "//ng-dev:node_modules/@types/jasmine",
        "//ng-dev:node_modules/@types/node",
        "//ng-dev/pr/common",
        "//ng-dev/release/versioning",
        "//ng-dev/utils/testing",
    ],
)

jasmine_test(
    name = "test",
    data = [
        ":test_lib",
    ],
    env = {
        "GIT_BIN": "$(GIT_BIN_PATH)",
    },
    toolchains = ["@devinfra//bazel/git-toolchain:current_git_toolchain"],
)
