{
  "problemMatcher": [
    {
      "owner": "angular-tslint",
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*(/[^\\s:]+\\.[cm]?[jt]sx?)(?:\\x1b\\[[0-9;]*m)*:\\d+:\\d+(?:\\x1b\\[[0-9;]*m)*$",
          "file": 1
        },
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*(ERROR|WARNING):\\s+(\\d+):(\\d+)\\s*(?:\\x1b\\[[0-9;]*m)*\\s+(?:\\x1b\\[[0-9;]*m)*([^\\s\\x1b]+)\\s*(?:\\x1b\\[[0-9;]*m)*\\s+(?:\\x1b\\[[0-9;]*m)*(.+?)(?:\\x1b\\[[0-9;]*m)*$",
          "severity": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5,
          "loop": true
        }
      ]
    },
    {
      "owner": "angular-ts-circular-deps",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*\\s*•\\s+(([^\\s→][^→]*?\\.[cm]?[jt]sx?)\\s+→\\s+.+?)(?:\\x1b\\[[0-9;]*m)*$",
          "message": 1,
          "file": 2
        }
      ]
    },
    {
      "owner": "angular-ng-dev-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\x1b\\[[0-9;]*m)*\\s*(?:[✘x](?:\\x1b\\[[0-9;]*m)*\\s{2,}(?:\\x1b\\[[0-9;]*m)*|!\\s+(?=Invalid\\s))(.+?)(?:\\x1b\\[[0-9;]*m)*$",
          "message": 1
        }
      ]
    }
  ]
}
